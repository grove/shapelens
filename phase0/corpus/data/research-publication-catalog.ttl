ex:grant-nord-42 a ex:Grant ; ex:grantNumber "NORD-42" .
ex:grant-data-7 a ex:Grant ; ex:grantNumber "DATA-7" .
ex:journal-a a ex:Venue ; ex:name "Journal A" .
ex:journal-b a ex:Venue ; ex:name "Journal B" .
ex:coast-data a ex:Dataset ; ex:name "Coastal Data" .
ex:earth-sciences a ex:Department ; ex:name "Earth Sciences" .
ex:data-science a ex:Department ; ex:name "Data Science" .
ex:deposit-1 a ex:Deposit ; ex:depositStatus ex:public .
