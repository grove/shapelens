@prefix ex: <https://catalog.example.org/ns/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:paper-1 a ex:Publication ;
  ex:title "Coastal Change Mapping" ;
  ex:publicationYear "2025"^^xsd:gYear ;
  ex:contributor ex:lee ;
  ex:publishedIn ex:journal-a ;
  ex:fundedBy ex:grant-nord-42 ;
  ex:usesDataset ex:coast-data ;
  ex:openAccessDeposit ex:deposit-1 .

ex:paper-2 a ex:Publication ;
  ex:title "Sea-Level Methods" ;
  ex:publicationYear "2025"^^xsd:gYear ;
  ex:contributor ex:lee, ex:patel ;
  ex:publishedIn ex:journal-b ;
