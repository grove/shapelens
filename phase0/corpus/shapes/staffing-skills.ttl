@prefix ex: <https://example.org/staffing/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:EmployeeStaffingShape a sh:NodeShape ;
  sh:targetClass ex:Employee ;
  sh:property [
    sh:path ex:workedOn ;
    sh:class ex:Project ;
    sh:minCount 1
  ], [
    sh:path ex:expertise ;
    sh:class ex:Skill ;
    sh:minCount 1
  ] .

ex:EmployeeDirectoryShape a sh:NodeShape ;
  sh:targetClass ex:Employee ;
  sh:property [
    sh:path ex:displayName ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] .

ex:ProjectStaffingShape a sh:NodeShape ;
  sh:targetClass ex:Project ;
  sh:property [
    sh:path [ sh:inversePath ex:workedOn ] ;
    sh:class ex:Employee
  ], [
    sh:path ex:title ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] .

ex:SkillShape a sh:NodeShape ;
  sh:targetClass ex:Skill ;
  sh:property [
    sh:path ex:label ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] .
